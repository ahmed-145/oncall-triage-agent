{
  "title": "On-call demo",
  "uid": "oncall-demo",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Shop requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(shop_requests_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Investigations per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(triage_investigations_total[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Evidence tool calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, status) (triage_tool_calls_total)"
        }
      ]
    },
    {
      "id": 4,
      "title": "P95 investigation duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(triage_investigation_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
